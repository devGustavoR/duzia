# Banco de dados (Supabase → Settings → Database → Connection string → URI)
# Sem aspas: este arquivo também é usado como env_file do Docker Compose,
# que não remove aspas — o valor entraria no container com elas incluídas.
DATABASE_URL=postgresql://postgres:SENHA@db.SEU_PROJECT_REF.supabase.co:5432/postgres

# Supabase (Settings → API)
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=seu_jwt_secret

# Chave usada para autenticar chamadas internas (header X-API-KEY)
API_KEY=gere_uma_chave_secreta

# CORS — URL(s) do frontend em produção (separadas por vírgula se houver mais de uma)
FRONTEND_URL=https://duzia.devgustavor.com.br

# Porta interna do container (o compose mapeia 127.0.0.1:3011 -> este PORT)
PORT=3001
